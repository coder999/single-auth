{
    "name": "coder999/single-auth",
    "description": "Shared PHP identity/session library for a primary domain and its subdomain apps",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Coder999\\SingleAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coder999\\SingleAuth\\Tests\\": "tests/"
        }
    }
}
